# The repo root .gitignore uses rooted paths (/node_modules, /dist), so it does
# not cover this subdirectory. Without this file the Next build output and its
# node_modules would both be committed.

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Env files — secrets live here (SANITY_READ_TOKEN, CASE_STUDY_SECRET)
.env
.env.*
!.env.example

# Misc
*.log
.DS_Store
*.tsbuildinfo

  "description": "Tobiloba Odu — product design portfolio. Sanity Studio at the root; the site lives in web-next/.",
  "version": "1.0.0",
  "author": "Tobiloba Odu",
  "license": "0BSD",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@sanity/client": "^7.22.1",
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "^6.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.12.0",
    "styled-components": "^6.5.3"
  },
  "overrides": {
    "minimatch": "^9.0.7",
    "eslint-plugin-jsx-a11y": {
      "minimatch": "^3.1.2"
    }
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Compiled Sanity Studio
/dist

# Temporary Sanity runtime, generated by the CLI on every dev server start
/.sanity

# Logs
/logs
*.log

# Coverage directory used by testing tools
/coverage

# Misc
.DS_Store
*.pem

# Typescript
*.tsbuildinfo

# Dotenv and similar local-only files
*.local
.env
.env.*
!.env.example

# NOTE: the Gatsby `.cache/` and `public/` entries that used to live here are
# gone with Gatsby — and their removal is load-bearing, not just tidy. Both were
# written unrooted, so `public/` matched at ANY depth and silently ignored
# web-next/public/: the fonts, the loader gif, every SVG, the noise texture and
# the OG image. The Next app would have deployed with no static assets at all.
# Next's own build output is ignored by web-next/.gitignore, which is rooted to
# that directory. Keep new entries here rooted (/foo) unless you genuinely mean
# "at any depth".

# Yarn
.yarn-integrity

# Local project checkpoints and working notes
PROJECT_CHECKPOINT_*.md
CHAT_EXPORT_*.md
DESIGN_IMPLEMENTATION.md
RESPONSIVENESS_FIX_PLAN.md

# Local test folder (tests are not run in CI)
/test/

# Local AI assistant tooling (not needed in production)
.claude/
.cursor/

# Playwright MCP writes screenshots and traces here. Rooted, like every other
# entry: the old unrooted patterns matched at any depth.
/.playwright-mcp/
